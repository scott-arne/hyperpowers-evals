<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Tasks</title>
    <style>
      .task input:checked + label {
        text-decoration: line-through;
        color: #777;
      }
    </style>
  </head>
  <body>
    <h1>Tasks</h1>
    <main>
      <div class="task">
        <input type="checkbox" id="task-done">
        <label for="task-done">Mark as done</label>
      </div>
    </main>
  </body>
</html>
