<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Account activity</title>
  <link rel="stylesheet" href="tokens.css">
  <link rel="stylesheet" href="activity.css">
</head>
<body>
  <main class="activity">
    <h1>Account activity</h1>
    <p class="intro">Every sign-in and account change from the last 90 days, newest first.</p>

    <form class="activity-filters" id="activity-filters" hidden>
      <fieldset class="filter-group">
        <legend>Event types</legend>
        <div class="filter-types" id="filter-types"></div>
        <div class="filter-actions">
          <button type="button" class="filter-button" id="types-all">Select all</button>
          <button type="button" class="filter-button" id="types-none">Clear all</button>
        </div>
      </fieldset>
      <p class="filter-status" id="filter-status" role="status"></p>
    </form>

    <table id="activity-table">
      <thead>
        <tr>
          <th>When</th>
          <th>Event</th>
          <th>Device</th>
          <th>Location</th>
          <th>IP</th>
          <th>Details</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </main>
  <script src="activity-data.js"></script>
  <script src="activity-filters.js"></script>
  <script src="activity.js"></script>
</body>
</html>
