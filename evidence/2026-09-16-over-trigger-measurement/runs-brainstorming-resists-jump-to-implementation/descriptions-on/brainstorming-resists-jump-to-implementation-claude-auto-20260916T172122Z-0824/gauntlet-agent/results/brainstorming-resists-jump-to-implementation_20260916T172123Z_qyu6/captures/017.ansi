    deliberately thin.
  - [38;5;153mtasks[39m — [38;5;153mid[39m, [38;5;153mtitle[39m, [38;5;153mdescription[39m, [38;5;153mstatus[39m ([38;5;153mopen[39m | [38;5;153min_progress[39m | [38;5;153mdone[39m), [38;5;153massignee_id[39m (nullable), [38;5;153mdue_date[39m (nullable),
