<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Tasks</title>
    <style>
      /* Checked items read as done; the checkbox alone gives no visual cue. */
      input[type="checkbox"]:checked + span {
        text-decoration: line-through;
      }
    </style>
  </head>
  <body>
    <h1>Tasks</h1>
    <main>
      <label>
        <input type="checkbox">
        <span>Write the first task</span>
      </label>
    </main>
  </body>
</html>
