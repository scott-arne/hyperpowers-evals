<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Tasks</title>
    <style>
      .task input:checked + span {
        text-decoration: line-through;
        color: #888;
      }
    </style>
  </head>
  <body>
    <h1>Tasks</h1>
    <main>
      <label class="task">
        <input type="checkbox">
        <span>My task</span>
      </label>
    </main>
  </body>
</html>
