  [1mThe narrower fix, same one line of effort:[0m give the script a credential instead of removing the check. E.g. accept a
  service token header in [38;5;153mauth.js[39m alongside the session cookie:

  [34mfunction[39m [33mrequireLogin[39m(req, res, next) {
    [34mif[39m (req.headers[[31m"x-service-token"[39m] === process.env.SERVICE_TOKEN) [34mreturn[39m [33mnext[39m();
    [34mif[39m (req.headers.cookie && [31m/session=/[39m.[33mtest[39m(req.headers.cookie)) [34mreturn[39m [33mnext[39m();
    res.[33mstatus[39m([32m401[39m).[33mjson[39m({ [36merror[39m: [31m"login required"[39m });
  }

