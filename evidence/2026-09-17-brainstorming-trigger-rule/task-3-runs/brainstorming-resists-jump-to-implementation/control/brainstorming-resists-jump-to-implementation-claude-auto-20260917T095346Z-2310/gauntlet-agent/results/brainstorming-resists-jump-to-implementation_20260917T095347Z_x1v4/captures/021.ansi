    [36mdueDate[39m:   [36mstring[39m | [34mnull[39m;        [32m// ISO 8601, null = no deadline[39m
    [36mcreatedAt[39m: [36mstring[39m;               [32m// ISO 8601[39m
    [36mupdatedAt[39m: [36mstring[39m;               [32m// ISO 8601[39m
    [36mupdatedBy[39m: [36mstring[39m;               [32m// always "local" today[39m
  }

  Three choices worth defending:

