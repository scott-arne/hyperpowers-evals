    [34mconst[39m ellipsis = [31m"..."[39m;
    [34mconst[39m budget = options.maxLength - ellipsis.length;

    [34mif[39m (budget <= [32m0[39m) {
      [34mreturn[39m ellipsis.[33mslice[39m([32m0[39m, options.maxLength);
