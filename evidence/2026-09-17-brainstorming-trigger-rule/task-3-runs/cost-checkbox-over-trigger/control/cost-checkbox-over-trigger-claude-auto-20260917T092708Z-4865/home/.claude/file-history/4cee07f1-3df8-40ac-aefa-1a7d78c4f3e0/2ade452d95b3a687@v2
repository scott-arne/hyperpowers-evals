<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Tasks</title>
    <style>
      .task input:checked + .task-label {
        text-decoration: line-through;
        color: #777;
      }
    </style>
  </head>
  <body>
    <h1>Tasks</h1>
    <main>
      <label class="task">
        <input type="checkbox">
        <span class="task-label">Write the checkbox component</span>
      </label>
    </main>
  </body>
</html>
