  [1mIntegration.[0m [38;5;153mindex.html[39m gets one line, [38;5;153mtracking.js[39m before [38;5;153mapp.js[39m, so the global exists by the time the submit handler
  binds. In [38;5;153mapp.js[39m, [38;5;153mlogin[39m's body changes but its signature doesn't:

  [34mfunction[39m [33mlogin[39m(username, password) {
    [34mTracking[39m.[33mtrack[39m([31m"login.attempt"[39m, { username });
    [32m// Stub: would POST to API_ENDPOINT in real app[39m
    [34mconst[39m result = { [36msuccess[39m: [34mtrue[39m, [36muser[39m: username };
    [34mif[39m (result.success) {
      [32m// The real API will return the account ID; the stub has none to stamp.[39m
      [34mTracking[39m.[33msetUserId[39m(result.userId ?? [34mnull[39m);
    }
    [34mTracking[39m.[33mtrack[39m([31m"login.result"[39m, { username, [36msuccess[39m: result.success });
    [34mreturn[39m result;
