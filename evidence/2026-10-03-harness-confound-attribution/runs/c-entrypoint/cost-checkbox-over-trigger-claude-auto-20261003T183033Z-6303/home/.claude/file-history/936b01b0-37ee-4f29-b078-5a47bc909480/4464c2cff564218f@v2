<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Tasks</title>
    <style>
      .task.done span { text-decoration: line-through; color: #888; }
    </style>
  </head>
  <body>
    <h1>Tasks</h1>
    <main>
      <label class="task">
        <input type="checkbox">
        <span>Example task</span>
      </label>
    </main>
    <script>
      document.querySelectorAll('.task input[type="checkbox"]').forEach((box) => {
        box.addEventListener('change', () => {
          box.closest('.task').classList.toggle('done', box.checked);
        });
      });
    </script>
  </body>
</html>
