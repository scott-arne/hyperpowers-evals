<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Tasks</title>
    <style>
      /* Give the on/off state a visible meaning: a checked task reads as done. */
      .task input:checked + span {
        text-decoration: line-through;
      }
    </style>
  </head>
  <body>
    <h1>Tasks</h1>
    <main>
      <label class="task">
        <input type="checkbox">
        <span>Example task</span>
      </label>
    </main>
  </body>
</html>
