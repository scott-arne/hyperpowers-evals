<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Tasks</title>
    <style>
      .task-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .task {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      /* The checked state is styled from the input itself, so marking a task
         done needs no script. */
      .task input:checked + label {
        text-decoration: line-through;
        opacity: 0.6;
      }
    </style>
  </head>
  <body>
    <h1>Tasks</h1>
    <main>
      <ul class="task-list">
        <li class="task">
          <input type="checkbox" id="task-1">
          <label for="task-1">Example task</label>
        </li>
      </ul>
    </main>
  </body>
</html>
