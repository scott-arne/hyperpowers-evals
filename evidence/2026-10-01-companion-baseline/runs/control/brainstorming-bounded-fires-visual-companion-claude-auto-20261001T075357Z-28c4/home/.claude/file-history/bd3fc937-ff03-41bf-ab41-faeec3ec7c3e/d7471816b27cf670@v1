body {
  font-family: system-ui, sans-serif;
  margin: 0;
  background: #f6f7f9;
}

.settings {
  max-width: 640px;
  margin: 3rem auto;
  padding: 2rem;
  background: #fff;
  border-radius: 8px;
}

.settings h1 {
  margin-top: 0;
  font-size: 1.5rem;
}

#settings-form {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

#settings-form label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
}

#settings-form button {
  align-self: flex-start;
  margin-top: 1rem;
  padding: 0.5rem 1rem;
}
