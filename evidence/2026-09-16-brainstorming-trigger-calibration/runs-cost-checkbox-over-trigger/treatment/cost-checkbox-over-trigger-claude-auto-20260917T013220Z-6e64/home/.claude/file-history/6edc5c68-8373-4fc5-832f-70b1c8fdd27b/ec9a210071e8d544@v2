<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Tasks</title>
    <style>
      .task-list {
        list-style: none;
        padding: 0;
      }

      /* Checked state is the only "done" signal, so style from the input. */
      .task input:checked + span {
        text-decoration: line-through;
        opacity: 0.6;
      }
    </style>
  </head>
  <body>
    <h1>Tasks</h1>
    <main>
      <ul class="task-list">
        <li>
          <label class="task">
            <input type="checkbox">
            <span>Write the first task</span>
          </label>
        </li>
      </ul>
    </main>
  </body>
</html>
