<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Tasks</title>
    <style>
      .task {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      /* Checked state is styled from the input itself, so no JS is needed. */
      .task input:checked + span {
        text-decoration: line-through;
        color: #666;
      }
    </style>
  </head>
  <body>
    <h1>Tasks</h1>
    <main>
      <label class="task">
        <input type="checkbox">
        <span>Write the checkbox component</span>
      </label>
      <label class="task">
        <input type="checkbox" checked>
        <span>Set up the tasks page</span>
      </label>
    </main>
  </body>
</html>
