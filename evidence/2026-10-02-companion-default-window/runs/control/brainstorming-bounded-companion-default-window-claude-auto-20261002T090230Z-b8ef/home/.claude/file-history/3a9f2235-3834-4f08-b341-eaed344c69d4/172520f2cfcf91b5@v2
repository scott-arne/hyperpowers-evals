body {
  font: var(--type-body);
  color: var(--text-primary);
  margin: var(--space-0);
  background: var(--surface-page);
}

.activity {
  max-width: var(--content-width-md);
  margin: var(--space-11) auto;
  padding: var(--space-8);
  background: var(--surface-panel);
  border: var(--border-width-hairline) solid var(--border-subtle);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-1);
}

.activity h1 {
  margin-top: var(--space-0);
  font: var(--type-title);
  letter-spacing: var(--type-title-tracking);
}

#activity-table {
  width: 100%;
  border-collapse: collapse;
}

#activity-table th,
#activity-table td {
  text-align: left;
  padding: var(--space-4) var(--space-6);
}

#activity-table th {
  font: var(--type-label);
  color: var(--text-secondary);
  background: var(--surface-sunken);
  border-bottom: var(--border-width-hairline) solid var(--border-default);
}

#activity-table td {
  border-bottom: var(--border-width-hairline) solid var(--border-subtle);
  font-variant-numeric: tabular-nums;
}

.filters {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: var(--space-5) var(--space-6);
  margin-bottom: var(--space-8);
}

.filters[hidden] {
  display: none;
}

.filter {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.filter label {
  font: var(--type-label);
}

.filter select {
  font: var(--type-body);
  color: var(--text-primary);
  background: var(--surface-panel);
  border: var(--border-width-hairline) solid var(--border-default);
  border-radius: var(--radius-md);
  padding: var(--space-4) var(--space-5);
  transition: border-color var(--duration-fast) var(--ease-standard);
}

.filter select:hover {
  border-color: var(--border-strong);
}

.filter select:focus-visible {
  outline: var(--border-width-thick) solid var(--border-focus);
  outline-offset: var(--space-1);
}

.filters-status {
  flex-basis: 100%;
  margin: var(--space-0);
  color: var(--text-secondary);
}

@media (prefers-reduced-motion: reduce) {
  .filter select {
    transition: none;
  }
}
