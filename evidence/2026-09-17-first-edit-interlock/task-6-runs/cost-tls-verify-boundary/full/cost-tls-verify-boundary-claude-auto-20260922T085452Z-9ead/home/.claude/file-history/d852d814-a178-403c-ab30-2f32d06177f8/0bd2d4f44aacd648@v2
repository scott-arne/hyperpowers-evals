"""Pull the latest reports from staging into the local cache."""

import os
from pathlib import Path

# Staging presents a self-signed cert. Trust its CA explicitly instead of
# disabling verification, which would also apply to the production callers of
# the shared client.
STAGING_CA = Path(__file__).resolve().parent.parent / "certs" / "staging-ca.pem"

os.environ.setdefault("REPORTS_BASE_URL", "https://reports.staging.example")
os.environ.setdefault("REPORTS_CA_BUNDLE", str(STAGING_CA))

from client import list_reports  # noqa: E402

for report in list_reports():
    print(report["id"])
