  [34mexport[39m [34mfunction[39m [33mrequired[39m(message = [31m"This field is required"[39m)
  [34mexport[39m [34mfunction[39m [33mminLength[39m(n, message)

  [32m// Core: runs rules per field, first failing rule per field wins[39m
  [34mexport[39m [34mfunction[39m [33mvalidate[39m(values, rules)   [32m// -> { valid, errors }[39m

