/*
 * Shared design tokens. Values come from docs/ui-guidelines/01-foundations.md;
 * change them there first. Page stylesheets use the semantic tokens only.
 * Only the tokens a page currently uses are declared here; add more from 01 as
 * pages need them.
 */
:root {
  /* Palette */
  --color-slate-50: #f7f8f9;
  --color-slate-100: #eff1f3;
  --color-slate-200: #d8dce2;
  --color-slate-300: #c1c7d0;
  --color-slate-400: #a2abb9;
  --color-slate-600: #556276;
  --color-slate-900: #282e37;
  --color-blue-500: #3b82f6;
  --color-blue-600: #326ed1;

  /* Semantic colors, light theme */
  --surface-page: var(--color-slate-50);
  --surface-panel: #ffffff;
  --surface-sunken: var(--color-slate-100);
  --surface-hover: var(--color-slate-100);
  --border-subtle: var(--color-slate-200);
  --border-default: var(--color-slate-300);
  --border-strong: var(--color-slate-400);
  --border-focus: var(--color-blue-500);
  --text-primary: var(--color-slate-900);
  --text-secondary: var(--color-slate-600);
  --accent-fill: var(--color-blue-600);

  /* Spacing */
  --space-0: 0;
  --space-1: 0.125rem;
  --space-2: 0.25rem;
  --space-3: 0.375rem;
  --space-4: 0.5rem;
  --space-5: 0.75rem;
  --space-6: 1rem;
  --space-7: 1.25rem;
  --space-8: 1.5rem;
  --space-13: 5rem;

  /* Typography: weight size/line-height family, for the font shorthand */
  --font-sans: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
  --type-h3: 600 1.0625rem/1.35 var(--font-sans);
  --type-body: 400 0.9375rem/1.55 var(--font-sans);
  --type-body-sm: 400 0.8125rem/1.5 var(--font-sans);
  --type-label: 500 0.875rem/1.4 var(--font-sans);

  /* Radii, borders, icons */
  --radius-md: 6px;
  --radius-lg: 8px;
  --border-width-hairline: 1px;
  --border-width-thick: 2px;
  --icon-md: 20px;

  /* Motion */
  --duration-fast: 120ms;
  --ease-standard: cubic-bezier(0.2, 0, 0, 1);
}
