/*
 * Shared token sheet. Values come from docs/ui-guidelines/01-foundations.md
 * (light theme). Page stylesheets reference the semantic tokens below and
 * never raw values. Add a token here only after it exists in 01.
 */
:root {
  /* Palette */
  --color-slate-50: #f7f8f9;
  --color-slate-100: #eff1f3;
  --color-slate-200: #d8dce2;
  --color-slate-300: #c1c7d0;
  --color-slate-400: #a2abb9;
  --color-slate-600: #556276;
  --color-slate-900: #282e37;
  --color-blue-50: #f5f8fe;
  --color-blue-500: #3b82f6;
  --color-blue-600: #326ed1;
  --color-red-50: #fef5f5;
  --color-red-700: #a72f2f;

  /* Surfaces */
  --surface-page: var(--color-slate-50);
  --surface-panel: #ffffff;
  --surface-sunken: var(--color-slate-100);
  --surface-hover: var(--color-slate-100);
  --surface-selected: var(--color-blue-50);

  /* Borders */
  --border-subtle: var(--color-slate-200);
  --border-default: var(--color-slate-300);
  --border-strong: var(--color-slate-400);
  --border-focus: var(--color-blue-500);
  --border-width-hairline: 1px;
  --border-width-thick: 2px;

  /* Text */
  --text-primary: var(--color-slate-900);
  --text-secondary: var(--color-slate-600);
  --text-disabled: var(--color-slate-400);

  /* Accent and state */
  --accent-fill: var(--color-blue-600);
  --danger-text: var(--color-red-700);
  --danger-subtle: var(--color-red-50);

  /* Spacing */
  --space-0: 0;
  --space-1: 0.125rem;
  --space-2: 0.25rem;
  --space-4: 0.5rem;
  --space-5: 0.75rem;
  --space-6: 1rem;
  --space-8: 1.5rem;
  --space-11: 3rem;

  /* Typography: font shorthand per role, plus tracking where it is not 0 */
  --font-sans: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;
  --type-title: 650 1.5rem/1.25 var(--font-sans);
  --type-title-tracking: -0.01em;
  --type-body: 400 0.9375rem/1.55 var(--font-sans);
  --type-body-sm: 400 0.8125rem/1.5 var(--font-sans);
  --type-body-sm-tracking: 0.005em;
  --type-label: 500 0.875rem/1.4 var(--font-sans);

  /* Radii */
  --radius-none: 0;
  --radius-md: 6px;
  --radius-lg: 8px;

  /* Elevation */
  --shadow-0: none;
  --shadow-1: 0 1px 2px rgb(15 23 42 / 0.06);

  /* Motion */
  --duration-fast: 120ms;
  --ease-standard: cubic-bezier(0.2, 0, 0, 1);
}
