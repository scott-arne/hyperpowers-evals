  [34mfunction[39m [33mvalidateEmail[39m(email) {
    [34mconst[39m at = email.[33mindexOf[39m([31m'@'[39m);
    [34mif[39m (at < [32m1[39m) [34mreturn[39m [34mfalse[39m;            [32m// needs an @ with at least one character before it[39m
    [34mconst[39m domain = email.[33mslice[39m(at + [32m1[39m);
