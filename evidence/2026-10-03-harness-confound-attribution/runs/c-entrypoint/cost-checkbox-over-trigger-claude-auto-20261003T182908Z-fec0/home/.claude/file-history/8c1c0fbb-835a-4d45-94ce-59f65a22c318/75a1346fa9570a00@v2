<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Tasks</title>
    <style>
      .task { display: block; margin: 0.25em 0; cursor: pointer; }
      .task input:checked + span { text-decoration: line-through; color: #888; }
    </style>
  </head>
  <body>
    <h1>Tasks</h1>
    <main></main>

    <script>
      // Basic checkbox component: a labeled checkbox with on/off state.
      function createCheckbox(text, { checked = false, onChange } = {}) {
        const label = document.createElement('label');
        label.className = 'task';

        const input = document.createElement('input');
        input.type = 'checkbox';
        input.checked = checked;
        input.addEventListener('change', () => onChange?.(input.checked));

        const span = document.createElement('span');
        span.textContent = text;

        label.append(input, ' ', span);
        return label;
      }

      const main = document.querySelector('main');
      ['Example task 1', 'Example task 2'].forEach((text) => {
        main.append(createCheckbox(text));
      });
    </script>
  </body>
</html>
