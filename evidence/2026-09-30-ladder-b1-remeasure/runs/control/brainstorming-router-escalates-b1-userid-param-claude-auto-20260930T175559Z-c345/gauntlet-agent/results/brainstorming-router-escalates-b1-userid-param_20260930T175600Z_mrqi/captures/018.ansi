[2m│[0m [1m[38;5;231mSection 3 — when login() throws (a future network error), what should the wrapper do?[0m

[38;5;153m❯[38;5;246m 1.[1m[38;5;153m Emit failure, then [0m          [38;5;246m┌───────────────────────────────────────────────────────────────┐[39m
    [1m[38;5;153mrethrow (Recommended)[0m         [38;5;246m│ [39mtry {[38;5;246m                                                         │[39m
 [38;5;246m 2.[39m Let it propagate             [38;5;246m│ [39m  result = await loginFn(username, password);[38;5;246m                 │[39m
    untracked                     [38;5;246m│ [39m} catch (err) {[38;5;246m                                               │[39m
 [38;5;246m 3.[39m Swallow into a failure       [38;5;246m│ [39m  await safeTrack("login.failure", {[38;5;246m                          │[39m
    result                        [38;5;246m│ [39m    userId: null, username, reason: "error",[38;5;246m                  │[39m
                                  [38;5;246m│ [39m  });[38;5;246m                                                         │[39m
                                  [38;5;246m│ [39m  throw err;              // caller still sees the real error[38;5;246m │[39m
                                  [38;5;246m│ [39m}[38;5;246m                                                             │[39m
