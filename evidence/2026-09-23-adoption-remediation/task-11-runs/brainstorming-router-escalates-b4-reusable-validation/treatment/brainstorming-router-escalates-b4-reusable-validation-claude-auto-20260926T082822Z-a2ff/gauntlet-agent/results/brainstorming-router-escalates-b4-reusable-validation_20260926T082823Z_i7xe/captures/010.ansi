    e.[33mpreventDefault[39m();
    [34mconst[39m values = [33mreadFormValues[39m(form);
    [34mconst[39m { valid, errors } = [33mvalidate[39m(values, loginSchema);
    [34mif[39m (!valid) { console.[33merror[39m([31m"Validation errors:"[39m, errors); [34mreturn[39m; }
    console.[33mlog[39m([31m"Login result:"[39m, [33mlogin[39m(values.username, values.password));
