    [36mlevel[39m:     [31m"info"[39m,                       [32m// debug | info | warn | error[39m
    [36mmsg[39m:       [31m"login attempt"[39m,              [32m// static string[39m
    [36msessionId[39m: [31m"9f2c..."[39m,                    [32m// ephemeral, per page load / process[39m
