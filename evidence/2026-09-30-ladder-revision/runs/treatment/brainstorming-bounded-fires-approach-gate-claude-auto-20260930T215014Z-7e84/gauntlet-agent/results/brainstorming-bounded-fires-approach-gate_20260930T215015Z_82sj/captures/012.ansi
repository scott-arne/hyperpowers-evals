    [34mconst[39m budget = maxLength - ELLIPSIS.length;
    [32m// Slice one past the budget so a word ending exactly at the budget still[39m
    [32m// shows up as a trailing space, rather than being cut back to the word before.[39m
    [34mconst[39m boundary = str.[33mslice[39m([32m0[39m, budget + [32m1[39m).[33mlastIndexOf[39m([31m' '[39m);
    [34mconst[39m cut = boundary > [32m0[39m ? boundary : budget;

    [34mreturn[39m str.[33mslice[39m([32m0[39m, cut) + ELLIPSIS;
  }

