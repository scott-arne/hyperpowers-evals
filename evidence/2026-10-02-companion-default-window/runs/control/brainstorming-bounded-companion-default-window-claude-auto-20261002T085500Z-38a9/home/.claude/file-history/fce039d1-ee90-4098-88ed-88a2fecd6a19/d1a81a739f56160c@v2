<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Account activity</title>
  <link rel="stylesheet" href="tokens.css">
  <link rel="stylesheet" href="activity.css">
</head>
<body>
  <main class="activity">
    <h1>Account activity</h1>
    <p class="intro">Every sign-in and account change from the last 90 days, newest first.</p>

    <!-- Hidden until activity.js runs, so there are no inert controls without JavaScript. -->
    <section class="filters" aria-label="Filter activity" hidden>
      <div class="filter-shortcuts">
        <button type="button" class="button" data-shortcut="failed">Show failed sign-ins</button>
        <button type="button" class="button" data-shortcut="security">Show security changes</button>
        <button type="button" class="button button-quiet" id="clear-filters">Clear filters</button>
      </div>
      <details class="filter-more">
        <summary>More filters</summary>
        <div class="filter-groups">
          <fieldset>
            <legend>Event type</legend>
            <div class="filter-types">
              <label><input type="checkbox" name="type" value="Sign-in" checked> Sign-in</label>
              <label><input type="checkbox" name="type" value="Sign-in failed" checked> Sign-in failed</label>
              <label><input type="checkbox" name="type" value="Sign-out" checked> Sign-out</label>
              <label><input type="checkbox" name="type" value="Session expired" checked> Session expired</label>
              <label><input type="checkbox" name="type" value="Password changed" checked> Password changed</label>
              <label><input type="checkbox" name="type" value="Two-factor enabled" checked> Two-factor enabled</label>
              <label><input type="checkbox" name="type" value="Email change requested" checked> Email change requested</label>
              <label><input type="checkbox" name="type" value="Settings updated" checked> Settings updated</label>
              <label><input type="checkbox" name="type" value="API token used" checked> API token used</label>
            </div>
          </fieldset>
          <fieldset>
            <legend>Date range</legend>
            <p class="hint" id="date-hint">Dates are in your time zone.</p>
            <div class="filter-dates">
              <div class="field">
                <label for="date-from">From</label>
                <input type="date" id="date-from" aria-describedby="date-hint">
              </div>
              <div class="field">
                <label for="date-to">To</label>
                <input type="date" id="date-to" aria-describedby="date-hint date-to-message">
                <p class="field-message" id="date-to-message" hidden>The end date must be after the start date.</p>
              </div>
            </div>
          </fieldset>
        </div>
      </details>
      <p class="filter-status" role="status"></p>
    </section>

    <table id="activity-table">
      <thead>
        <tr>
          <th>When</th>
          <th>Event</th>
          <th>Device</th>
          <th>Location</th>
          <th>IP</th>
          <th>Details</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
    <p class="no-matches" hidden>No events match these filters.</p>
  </main>
  <script src="activity-data.js"></script>
  <script src="activity.js"></script>
</body>
</html>
