  │ [38;5;153msrc/store.js[39m           │ Load/save to localStorage under a versioned key; storage injected │ [38;5;153mtask.js[39m    │
  ├────────────────────────┼───────────────────────────────────────────────────────────────────┼────────────┤
  │ [38;5;153msrc/alerts.js[39m          │ [38;5;153mcomputeAlerts(tasks, now)[39m — pure                                  │ [38;5;153mtask.js[39m    │
  ├────────────────────────┼───────────────────────────────────────────────────────────────────┼────────────┤
