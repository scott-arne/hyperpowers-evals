  ├─────────────────────┼─────────────────────────────────────────────────────────────┼─────────────────┤
  │ [38;5;153mmodel/event.js[39m      │ Event shape, dedupe-key construction                        │ nothing         │
  ├─────────────────────┼─────────────────────────────────────────────────────────────┼─────────────────┤
  │ [38;5;153mengine/clock.js[39m     │ [38;5;153mnow()[39m behind an injectable seam                             │ nothing         │
  ├─────────────────────┼─────────────────────────────────────────────────────────────┼─────────────────┤
  │ [38;5;153mengine/rules.js[39m     │ Rule definitions: [38;5;153m(task, now) → candidate firings[39m           │ model, clock    │
  ├─────────────────────┼─────────────────────────────────────────────────────────────┼─────────────────┤
  │ [38;5;153mengine/scheduler.js[39m │ [38;5;153mevaluate(tasks, seenKeys, now) → NotificationEvent[][39m — pure │ model, rules    │
  ├─────────────────────┼─────────────────────────────────────────────────────────────┼─────────────────┤
  │ [38;5;153mstore/index.js[39m      │ Async persistence interface                                 │ model           │
  ├─────────────────────┼─────────────────────────────────────────────────────────────┼─────────────────┤
  │ [38;5;153mstore/local.js[39m      │ localStorage implementation                                 │ store interface │
  ├─────────────────────┼─────────────────────────────────────────────────────────────┼─────────────────┤
  │ [38;5;153mui/*.js[39m             │ Task list, inbox, toasts, badge                             │ model, store    │
  ├─────────────────────┼─────────────────────────────────────────────────────────────┼─────────────────┤
